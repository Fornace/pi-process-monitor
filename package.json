{
  "name": "pi-process-monitor",
  "version": "2.0.1",
  "description": "Non-blocking background watcher for pi: start a process, SSH poll, or log tail and get pinged in-session on milestones, failure, or exit. Claude Code's Monitor tool, with conditional delivery.",
  "type": "module",
  "license": "MIT",
  "author": "Francesco Frapporti <effedue@gmail.com>",
  "homepage": "https://github.com/Fornace/pi-process-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fornace/pi-process-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Fornace/pi-process-monitor/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "monitor",
    "watcher",
    "background",
    "long-running",
    "training",
    "ssh",
    "log-tail",
    "notifications",
    "claude-code",
    "ai",
    "agent"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "docs/preview.png",
    "docs/CRASH-SAFE-RECOVERY-BRIEF-2026-08-02.md",
    "docs/GROUNDING-RECEIPT-2026-08-02.md",
    "docs/MIGRATION-v2.md",
    "docs/COMPLETION-AUDIT-2026-08-02.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://github.com/Fornace/pi-process-monitor/raw/refs/heads/main/docs/preview.png"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:smoke": "node test/load.mjs",
    "test:real-pi": "node test/real-pi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "npm run typecheck && npm test && npm run test:smoke && MONITOR_TEST_PROVIDER=${MONITOR_TEST_PROVIDER:-fornace} MONITOR_TEST_MODEL=${MONITOR_TEST_MODEL:-fornace-max} npm run test:real-pi && npm pack --dry-run --json >/dev/null",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "engines": {
    "node": ">=20"
  }
}
